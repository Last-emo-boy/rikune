# =============================================================================
# Rikune - Docker Analysis Stack (Plugin-Driven)
# =============================================================================
# Generated from docker/Dockerfile.template by: npm run docker:generate
# Multi-stage build driven by plugin systemDeps declarations and
# per-feature docker/*.dockerfile fragments.
# =============================================================================

# -----------------------------------------------------------------------------
# Global Arguments
# -----------------------------------------------------------------------------
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ARG http_proxy=""
ARG https_proxy=""
ARG NO_PROXY="localhost,127.0.0.1,deb.debian.org,security.debian.org,archive.ubuntu.com,security.ubuntu.com"
{{FEATURE_ARGS}}

# =============================================================================
# Stage 1: TypeScript Builder (always)
# =============================================================================
FROM node:22-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

ARG HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NO_PROXY
ENV HTTP_PROXY="${HTTP_PROXY}" \
    HTTPS_PROXY="${HTTPS_PROXY}" \
    http_proxy="${http_proxy}" \
    https_proxy="${https_proxy}" \
    NO_PROXY="${NO_PROXY}"

# Native addons must compile from the npm tarball sources. This prevents
# install scripts from fetching unverified prebuilt binaries outside the lock.
ENV npm_config_build_from_source=true \
    npm_config_nodedir=/usr/local

RUN npm config set audit false && \
    npm config set fund false

WORKDIR /app
COPY package*.json ./
COPY turbo.json ./
COPY tsconfig*.json ./
COPY packages/ ./packages/
RUN npm ci --legacy-peer-deps --no-audit --no-fund && \
    node -e "const Database=require('better-sqlite3');const db=new Database(':memory:');db.exec('SELECT 1');db.close()"

COPY scripts/ ./scripts/
COPY src/ ./src/
RUN npm run build
RUN test -f /app/dist/index.js

# =============================================================================
# Stage 2: Python Base (baseline + global packages)
# =============================================================================
FROM python:3.12-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134 AS python-base

ARG HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NO_PROXY

ENV HTTP_PROXY="${HTTP_PROXY}" \
    HTTPS_PROXY="${HTTPS_PROXY}" \
    http_proxy="${http_proxy}" \
    https_proxy="${https_proxy}" \
    NO_PROXY="${NO_PROXY}"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    file \
    git \
    libyara-dev \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.lock.txt ./requirements.lock.txt
COPY workers/ ./workers/
# Plugin-specific workers (auto-generated from src/plugins/*/workers/)
{{PLUGIN_WORKER_COPY}}

RUN pip install --no-cache-dir --require-hashes -r requirements.lock.txt
# @if dynamic-python
RUN pip install --no-cache-dir --require-hashes -r workers/requirements-dynamic.lock.txt
# @endif dynamic-python

RUN ls -la /app/workers/ && \
    python3 -c "import sys; sys.path.insert(0, '/app/workers'); import static_worker; print('static_worker.py loaded')" && \
    python3 -m py_compile /app/workers/static_worker.py && \
    echo "Python base validated"

# @if dynamic-python
RUN python3 -c "import yara_x, pandare, frida, psutil; import speakeasy; print('global dynamic imports ready')" && \
    python3 -c "import importlib.metadata as m; print('frida-tools', m.version('frida-tools')); print('yara-x', m.version('yara-x'))" && \
    echo "Dynamic Python extras validated"
# @endif dynamic-python

# =============================================================================
# Feature Build Stages (auto-inserted from plugin docker/*.dockerfile fragments)
# =============================================================================
{{BUILD_STAGES}}

# =============================================================================
# Runtime
# =============================================================================
FROM python:3.12-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134 AS runtime

ARG HTTP_PROXY HTTPS_PROXY http_proxy https_proxy NO_PROXY

ENV HTTP_PROXY="${HTTP_PROXY}" \
    HTTPS_PROXY="${HTTPS_PROXY}" \
    http_proxy="${http_proxy}" \
    https_proxy="${https_proxy}" \
    NO_PROXY="${NO_PROXY}"

LABEL maintainer="rikune"
LABEL version="{{RIKUNE_VERSION}}"
LABEL description="MCP server for Windows binary reverse engineering"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    file \
    libstdc++6 \
    libgcc-s1 \
    wget \
    xz-utils \
{{RUNTIME_APT_PACKAGES}}    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# -- Node.js artifacts (always) --
COPY --from=builder /usr/local/bin/node /usr/local/bin/node
COPY --from=builder /usr/local/bin/npm /usr/local/bin/npm
COPY --from=builder /usr/local/bin/npx /usr/local/bin/npx
COPY --from=builder /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./
COPY LICENSE DISCLOSURE ./
RUN chown root:root /app/LICENSE /app/DISCLOSURE && \
    chmod 0444 /app/LICENSE /app/DISCLOSURE
{{STATIC_PROFILE_LOCK_COPY}}
COPY scripts/secure-fs-helper.py scripts/verify-hybrid-runtime.mjs ./scripts/
RUN chown root:root ./scripts/secure-fs-helper.py ./scripts/verify-hybrid-runtime.mjs && \
    chmod 0555 ./scripts/secure-fs-helper.py ./scripts/verify-hybrid-runtime.mjs

# Data files (API semantics, etc.)
RUN mkdir -p ./data
COPY src/plugins/kb-collaboration/data/windows-api-semantics.json ./src/plugins/kb-collaboration/data/windows-api-semantics.json
# Plugin-specific data files (auto-generated from src/plugins/*/data/)
{{PLUGIN_DATA_COPY}}

# Dashboard static assets (not handled by tsc)
COPY src/api/dashboard/ ./dist/api/dashboard/

# Plugin static scripts exposed through MCP resources
{{PLUGIN_SCRIPT_COPY}}

# -- Python base (always) --
COPY --from=python-base /usr/local/bin /usr/local/bin
COPY --from=python-base /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=python-base /app/workers ./workers
# Plugin-specific workers (auto-generated from src/plugins/*/workers/)
{{PLUGIN_WORKER_COPY_FROM}}

RUN python3 -m py_compile ./workers/static_worker.py || echo "Python worker validation skipped"

# -- Feature-specific runtime (auto-inserted from plugin docker/*.dockerfile fragments) --
{{FEATURE_RUNTIME}}

COPY src/plugins/static-triage/helpers/ ./src/plugins/static-triage/helpers/

# -- Validate installed tools --
{{VALIDATION_COMMANDS}}

RUN useradd --no-create-home --home-dir /nonexistent -u 1000 -s /usr/sbin/nologin appuser

RUN mkdir -p /app/storage/samples /app/storage/artifacts /app/storage/uploads /app/storage/.metadata && \
    chown -R appuser:appuser /app/storage

RUN mkdir -p /app/uploads && chown -R appuser:appuser /app/uploads

EXPOSE 18080
EXPOSE 18081

ENV NODE_ENV=production \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/workers \
    WORKSPACE_ROOT=/app/workspaces \
    DB_PATH=/app/data/database.db \
    CACHE_ROOT=/app/cache \
    HOME=/tmp/rikune-home \
    RUNNING_IN_DOCKER=true \
    API_ENABLED=false \
    API_PORT=18080 \
    API_STORAGE_ROOT=/app/storage \
    UPLOAD_PORT=18081 \
    AUDIT_LOG_PATH=/app/logs/audit.log \
    XDG_CONFIG_HOME=/tmp/rikune-home/.config \
    XDG_CACHE_HOME=/tmp/rikune-home/.cache \
    SANDBOX_PYTHON_PATH=/usr/local/bin/python3
{{RUNTIME_ENV_VARS}}
{{STATIC_PROFILE_ENV}}

RUN mkdir -p /app/workspaces /app/data /app/cache /tmp/rikune-home /app/logs /samples /tmp {{EXTRA_DIRS}} && \
    chown -R appuser:appuser /app/workspaces /app/data /app/cache /app/logs /app/storage /app/uploads /tmp/rikune-home && \
{{EXTRA_CHOWN}}    chmod 1777 /tmp
RUN chown root:root /app /app/package.json && \
    chmod go-w /app /app/package.json && \
    find /app/dist /app/node_modules /app/packages /app/workers /app/src /app/scripts \
      -xdev -exec chown -h root:root {} + && \
    find /app/dist /app/node_modules /app/packages /app/workers /app/src /app/scripts \
      -xdev ! -type l -exec chmod go-w {} +
{{STATIC_PROFILE_IMAGE_CONTRACT}}

WORKDIR /app

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN sed -i 's/\r$//' /docker-entrypoint.sh && \
    chown root:root /docker-entrypoint.sh && \
    chmod 0555 /docker-entrypoint.sh

{{STATIC_PROFILE_USER}}
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["node", "dist/index.js"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node --input-type=module --eval "if(!['true','1'].includes(process.env.API_ENABLED||''))process.exit(0);const c=new AbortController();const t=setTimeout(()=>c.abort(),5000);try{const r=await fetch('http://127.0.0.1:18080/api/v1/health',{signal:c.signal});process.exit(r.ok?0:1)}catch{process.exit(1)}finally{clearTimeout(t)}" || exit 1
